<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appender name="DEFAULT_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="KAFKA_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} - [Read from Kafka] %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="DB_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} - [Write to DB] %msg%n</pattern>
        </encoder>
    </appender>


    <logger name="com.example.test.KafkaConsumer" level="INFO" additivity="false">
        <appender-ref ref="KAFKA_CONSOLE"/>
    </logger>

    <logger name="com.example.test.DatabaseService" level="INFO" additivity="false">
        <appender-ref ref="DB_CONSOLE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="DEFAULT_CONSOLE"/>
    </root>

</configuration>